{
  "name": "VKDG Gateway",
  "build": {
    "dockerfile": "Dockerfile",
    "args": { "VARIANT": "1" }
  },
  "features": {
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "stable",
      "profile": "minimal",
      "components": "rust-analyzer,rust-src,rustfmt,clippy"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb",
        "svelte.svelte-vscode",
        "bradlc.vscode-tailwindcss"
      ],
      "settings": {
        "files.watcherExclude": {
          "**/target/**": true,
          "**/node_modules/**": true,
          "**/.svelte-kit/**": true
        },
        "rust-analyzer.cargo.features": "all",
        "rust-analyzer.checkOnSave.command": "clippy"
      }
    }
  },
  "postCreateCommand": "curl -fsSL https://bun.sh/install | bash && echo 'export PATH=\"$HOME/.bun/bin:$PATH\"' >> ~/.bashrc",
  "postStartCommand": "echo 'VKDG dev container ready. Run: just dev'",
  "capAdd": ["SYS_PTRACE"],
  "securityOpt": ["seccomp=unconfined"],
  "remoteUser": "vscode"
}
