# =============================================================================
# Security — NEVER commit secrets
# =============================================================================

# Environment files (real values)
.env
.env.*
!.env.example
!.env.*.example

# Vault / secret files
*.vault
*.vault.json
*.secret
secrets/
.secrets/

# Credentials / keys
credentials.json
credentials.toml
service-account*.json
*_credentials.*
*.pem
*.key
!*.pub.key
*.p12
*.pfx

# SSH keys
id_rsa
id_ed25519
*.ppk

