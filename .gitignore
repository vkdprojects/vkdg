# =============================================================================
# Rust workspace
# =============================================================================

# Cargo build output
/target/
debug/

# rustfmt backups
**/*.rs.bk

# MSVC debug info
*.pdb

# cargo-mutants output
**/mutants.out*/

# rustc internal error traces
rustc-ice-*.txt

# NOTE: Cargo.lock is intentionally NOT ignored.
# This workspace has binaries (bin/vkdg) → commit the lockfile for reproducible builds.

# =============================================================================
# Build / codegen artifacts
# =============================================================================

# wasm-pack output
pkg/
wasm-pkg/

# cargo-make / just temp
.task/

