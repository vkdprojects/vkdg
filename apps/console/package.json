{
  "name": "vkdg-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint:tokens": "bun scripts/lint-tokens.ts",
    "lint:dup": "scripts/lint-dup.sh",
    "lint": "bun run lint:tokens && bun run lint:dup && bun run check"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.4",
    "@playwright/test": "1.62.0",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/adapter-static": "3.0.8",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.6.3",
    "msw": "2.7.5",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@fontsource-variable/doto": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "bits-ui": "^2.19.3",
    "lucide-svelte": "^1.0.1",
    "svelte-sonner": "^1.2.1"
  }
}
