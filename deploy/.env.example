# VKDG production environment
# Copy this file to deploy/.env and fill in your values

# Security — generate with: openssl rand -hex 32
VKDG_BOOTSTRAP_TOKEN=change-me-before-production

# Ports (optional, defaults shown)
GATEWAY_PORT=8080
ADMIN_PORT=9090
CONSOLE_PORT=9091

# Public URL of the console (used for CORS + cookies)
ORIGIN=http://localhost:9091

# Provider API keys — add the ones you use
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
