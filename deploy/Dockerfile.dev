# Dev image: packages an already cross-compiled binary.
#
# Dockerfile.gateway compiles Rust inside the build, which is correct for a
# release but costs ~15 min on a modest x86 host and far longer under emulation.
# For a dev loop, compile on the host instead — `rustc` runs natively on ARM and
# emits x86, with no translation layer — and let the image just package the result.
#
#   just image-dev
#
# Measured on an M4 Pro: 1m39s host cross-compile versus 14m28s compiling inside
# the image on a 4-core Broadwell server.
#
# Expects, relative to the build context:
#   target/x86_64-unknown-linux-musl/release/vkdg   (just build-linux-amd64)
#
# The console is already baked into the binary by rust-embed at compile time, so
# there is nothing else to copy.

FROM debian:bookworm-slim AS certs
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

FROM scratch
COPY --from=certs /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY target/x86_64-unknown-linux-musl/release/vkdg /vkdg
EXPOSE 8080 9090
ENTRYPOINT ["/vkdg"]
CMD ["serve"]
