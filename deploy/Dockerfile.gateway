FROM rust:1.80 AS builder
WORKDIR /app
COPY . .
RUN cargo build --release -p vkdg

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/vkdg /usr/local/bin/vkdg
EXPOSE 8080 9090
CMD ["vkdg", "serve"]
