# syntax=docker/dockerfile:1

# Stage 1: Build SvelteKit console
FROM oven/bun:1-alpine AS console-builder
WORKDIR /app/apps/console
COPY apps/console/package.json apps/console/bun.lock ./
# No --frozen-lockfile: lockfile may have platform-specific entries
RUN bun install
COPY apps/console/src ./src
COPY apps/console/static ./static
COPY apps/console/svelte.config.js \
     apps/console/tsconfig.json \
     apps/console/vite.config.ts \
     apps/console/vitest.config.ts ./
COPY apps/console/project.inlang ./project.inlang
COPY apps/console/messages ./messages
RUN bun run build

# Stage 2a: cargo-chef planner — computes a recipe (dependency graph + stub
# layout) from the full workspace. This stage is cheap and its output
# (recipe.json) is a function of Cargo.toml/Cargo.lock content only: chef
# ignores non-manifest files when hashing, so editing a .rs file or anything
# under apps/console/** changes this stage's input but NOT recipe.json's
# content, which keeps the cook stage below cached (Docker caches a COPY by
# the copied file's content, not by whether the producing stage re-ran).
#
# Why cargo-chef instead of a hand-rolled stub script: this workspace has 41
# members (crates/, plugins/providers/*, bin/, tests/, bench/) mixing lib,
# bin, and bench-only (no src/, just [[bench]] harness=false) targets. A
# manual `find -name '*.rs' -exec ... stub` script has no way to invent
# missing files for crates that don't have any yet, silently breaks the
# moment someone adds a 42nd crate or a new [[bin]], and (as shipped here)
# masked its own failure behind `| tail`. cargo-chef reads `cargo metadata`
# to learn the *real* target shape of every member and generates exactly the
# right stub files itself — it does not need this Dockerfile to know the
# workspace layout at all.
FROM rust:1-alpine AS chef
RUN apk add --no-cache musl-dev pkgconfig openssl-dev
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo install cargo-chef --locked
WORKDIR /app

FROM chef AS planner
COPY . .
# rust-embed's #[derive] walks this folder at macro-expansion time for every
# crate that depends on bin/vkdg's console assets; it only needs to exist,
# not contain the real build, and an empty dir is enough (verified against
# rust-embed 8.12). Without it `cargo metadata`/`cargo chef prepare` fails
# for the same reason the original console build failed.
RUN mkdir -p apps/console/build
RUN set -o pipefail && cargo chef prepare --recipe-path recipe.json

# Stage 2b: Build Rust binary with cached dependencies
FROM chef AS rust-builder
COPY --from=planner /app/recipe.json recipe.json
RUN mkdir -p apps/console/build

# Build ONLY dependencies, keyed on recipe.json (i.e. on every workspace
# Cargo.toml + Cargo.lock). Cached across builds that only touch .rs source
# or apps/console/**. No `| tail`/pipe on the build command: pipefail is set
# explicitly so a real compile failure fails the RUN step instead of being
# swallowed by a downstream command's always-zero exit code.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/app/target \
    set -o pipefail && \
    cargo chef cook --release --target x86_64-unknown-linux-musl --workspace --recipe-path recipe.json

# Copy full source code (this layer is cached unless source changes)
COPY . .

# Inject pre-built console — rust-embed bakes it in at compile time
COPY --from=console-builder /app/apps/console/build ./apps/console/build

# Build final binary with cached deps, copy OUTSIDE target mount
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/app/target \
    set -o pipefail && \
    cargo build --release --target x86_64-unknown-linux-musl -p vkdg \
    && cp target/x86_64-unknown-linux-musl/release/vkdg /usr/local/bin/vkdg

# Stage 3: CA certificates for upstream HTTPS calls
FROM debian:bookworm-slim AS certs
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Stage 4: Minimal scratch runtime (no shell, no package manager)
FROM scratch
COPY --from=certs /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=rust-builder /usr/local/bin/vkdg /vkdg
EXPOSE 8080 9090
ENTRYPOINT ["/vkdg"]
CMD ["serve"]
