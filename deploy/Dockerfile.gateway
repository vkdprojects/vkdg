# Stage 1: Build with musl target
FROM rust:1.80-alpine AS builder
RUN apk add --no-cache musl-dev pkgconfig openssl-dev bun
WORKDIR /app
COPY . .
# Build console first (gets embedded in binary)
RUN cd apps/console && bun install --frozen-lockfile && bun run build
# Build static binary
RUN cargo build --release -p vkdg --target x86_64-unknown-linux-musl

# Stage 2: Minimal runtime (scratch = smallest possible)
FROM scratch
COPY --from=builder /app/target/x86_64-unknown-linux-musl/release/vkdg /vkdg
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
EXPOSE 8080 9090
ENTRYPOINT ["/vkdg"]
CMD ["serve"]
