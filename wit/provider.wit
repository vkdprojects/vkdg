package vkdg:provider@0.1.0;

interface types {
    /// Opaque bytes for a prepared request body.
    type request-body = list<u8>;
    type response-body = list<u8>;

    record prepared-request {
        url: string,
        body: request-body,
        is-streaming: bool,
    }

    variant error {
        capability-unsupported(string),
        upstream-error(u16),
        internal(string),
    }
}

world provider {
    use types.{prepared-request, error};

    /// Called by the host with the serialized Operation JSON and connection config JSON.
    /// Returns a PreparedRequest or an error.
    export prepare: func(operation-json: string, config-json: string, token: string) -> result<prepared-request, error>;

    /// Plugin name for logging and registry.
    export name: func() -> string;
}
