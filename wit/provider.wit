package vkdg:plugin@0.1.0;

/// Provider adapter plugin.
/// Translates VKDG internal Operation -> provider wire format and back.
/// The gateway owns the HTTP client, TLS, DNS, auth injection, and retry.
/// The plugin only transforms bytes.
interface provider-plugin {
    use types.{request, response, plugin-error};

    /// Translate a VKDG request into the provider's wire format.
    /// Returns: (url, body-bytes, is-streaming)
    ///
    /// connection-config-json: JSON-serialized ConnectionConfig without credentials.
    /// Shape: { "id": string, "provider": string, "models": [string],
    ///          "max_concurrent": u32, "weight": u32, "tags": [string] }
    /// The auth token is passed separately as the `token` argument.
    /// The gateway strips credentials before calling this function.
    translate-request: func(
        req: request,
        connection-config-json: string,
        token: string,
    ) -> result<tuple<string, list<u8>, bool>, plugin-error>;

    /// Translate a complete (non-streaming) provider response body.
    translate-response: func(
        body: list<u8>,
        request-id: string,
    ) -> result<response, plugin-error>;

    /// Translate one SSE chunk from the provider's wire format.
    ///
    /// Return values:
    /// - Ok(Some(response)): chunk produced a complete event; include in stream.
    /// - Ok(None):           skip this chunk (comment line, heartbeat, empty event).
    /// - Err(not-applicable): this plugin does not support streaming at all;
    ///   the gateway will call translate-response on the complete buffered body
    ///   instead. Return this only once; not once per chunk.
    /// - Err(internal):      chunk could not be parsed; gateway will terminate stream.
    translate-chunk: func(
        chunk: list<u8>,
        request-id: string,
    ) -> result<option<response>, plugin-error>;

    /// List of model IDs or glob patterns this provider handles.
    /// e.g. ["claude-*", "claude-3-5-haiku-20241022"]
    model-patterns: func() -> list<string>;

    name: func() -> string;
}

world provider {
    export provider-plugin;
}
