// VKDG Plugin Interface — vkdg:plugin@0.1.0
//
// VERSIONING
// The package version (0.1.0) is the ABI version. Patch bumps (0.1.x) are
// backwards-compatible. Minor bumps (0.2.0) may add types; they do not remove
// or rename existing items. Major bumps are breaking. A plugin compiled against
// 0.1.x loads on any host supporting 0.1.y where y >= x.
//
// ERROR CONVENTIONS
// plugin-error variants carry freeform strings EXCEPT:
// - rate-limit errors from auth-plugin::check-rate-limit use "retry-after:N"
//   format where N is seconds: e.g. rejected("retry-after:30")
// - not-applicable means "skip me, I do not handle this request type"
//
// SIGNAL NAMESPACES
// The signal-map type (list<tuple<string, string>>) uses namespaced keys:
//   compress:tokens_before    u32 as string, set by compressor plugins
//   compress:tokens_after     u32 as string
//   compress:algorithm        string name ("caveman", "rtk", etc.)
//   auth:tenant_id            string, set by auth plugins
//   router:cost_estimate      microdollars as string
// Reserve your namespace with a PR to contracts/admin/openapi.yaml.

/// Core domain types shared across all plugin interfaces.
/// The gateway owns HTTP, I/O, credentials, and config.
/// Plugins are pure transform functions with no ambient authority.
package vkdg:plugin@0.1.0;

interface types {
    // ── Identity ─────────────────────────────────────────────────────────────

    /// Opaque tenant identifier.
    type tenant-id = string;
    /// Opaque request correlation ID (UUIDv4 as string).
    type request-id = string;
    /// Plugin-declared name, e.g. "anthropic", "rtk-compressor", "redis-cache".
    type plugin-name = string;

    // ── Request / Response ────────────────────────────────────────────────────

    record message {
        role:         string,
        content:      string,
        /// For role=tool: the id of the tool call this is a result for.
        tool-call-id: option<string>,
        /// tool_calls produced by role=assistant.
        tool-calls:   list<tool-call>,
    }

    record tool-call {
        id:        string,
        name:      string,
        arguments: string,  // JSON string
    }

    record request {
        id:         request-id,
        tenant-id:  tenant-id,
        model:      string,
        messages:   list<message>,
        /// system prompt, if provided separately from messages
        system:     option<string>,
        /// `%` escapes the WIT keyword; the field is still named `stream`.
        %stream:    bool,
        max-tokens: option<u32>,
        temperature: option<f32>,
        /// arbitrary key-value metadata threaded through the pipeline
        metadata:   list<tuple<string, string>>,
        /// raw extension bytes preserved from the incoming protocol
        extensions: list<tuple<string, list<u8>>>,
    }

    record response {
        id:           request-id,
        model:        string,
        content:      string,
        tool-calls:   list<tool-call>,
        finish-reason: string,
        usage:        option<usage>,
        /// metadata injected or propagated by plugins
        metadata:     list<tuple<string, string>>,
    }

    record usage {
        prompt-tokens:     u32,
        completion-tokens: u32,
        cache-read-tokens:  option<u32>,
        cache-write-tokens: option<u32>,
    }

    // ── Credentials ───────────────────────────────────────────────────────────

    /// The credential for one upstream call.
    ///
    /// `extra` is the plugin's own per-account data, persisted by the gateway at
    /// login and refresh and handed back verbatim: region, tenant/profile ids,
    /// which login method issued the token, whatever the provider needs. The
    /// gateway never interprets these keys.
    record credential {
        /// API key or access token. Already refreshed; use as-is.
        token: string,
        extra: list<tuple<string, string>>,
    }

    /// Tokens plus the account data to persist alongside them.
    record token-pair {
        access-token:    string,
        refresh-token:   option<string>,
        /// Seconds until `access-token` expires; none = unknown.
        expires-in-secs: option<u64>,
        /// Merged into the stored account; keys returned here overwrite stored ones.
        extra:           list<tuple<string, string>>,
    }

    // ── Interactive login ─────────────────────────────────────────────────────

    /// One input a login method needs, rendered as a CLI flag or a form field.
    record login-field {
        id:       string,
        label:    string,
        required: bool,
        /// Mask the value in UIs (pasted tokens, secrets).
        secret:   bool,
        default-value: option<string>,
    }

    /// A login method the plugin supports, e.g. device code or pasted token.
    /// The gateway renders these generically; it knows nothing provider-specific.
    record login-method {
        id:     string,
        label:  string,
        /// "device-code" | "pkce" | "import"
        flow:   string,
        fields: list<login-field>,
    }

    /// Plugin-defined login inputs, keyed by `login-field.id`.
    type login-params = list<tuple<string, string>>;

    /// Opaque plugin state carried between the start and the end of a login
    /// (device code, PKCE verifier, client registration). Never shown to users.
    type login-state = list<tuple<string, string>>;

    /// What the user must do to approve a device-code login.
    record device-authorization {
        verification-uri:          string,
        verification-uri-complete: option<string>,
        user-code:                 string,
        /// Minimum seconds between polls.
        interval-secs:             u64,
        expires-in-secs:           u64,
        state:                     login-state,
    }

    /// Where to send the user for a PKCE login.
    record pkce-authorization {
        authorize-url: string,
        state:         login-state,
    }

    /// A completed login.
    record login-result {
        tokens: token-pair,
        /// Account identity for listings (email, profile name). Empty = plugin id.
        label:  string,
    }

    /// Outcome of one device-code poll.
    variant device-poll {
        /// Not approved yet; poll again after the interval.
        pending,
        /// Server asked to slow down; add 5s to the interval (RFC 8628 §3.5).
        slow-down,
        done(login-result),
        /// Terminal failure (denied, expired, invalid); message is safe to show.
        failed(string),
    }

    // ── Streaming ─────────────────────────────────────────────────────────────

    /// One decoded event from a provider stream.
    ///
    /// A provider whose wire protocol is not SSE (AWS EventStream, a custom binary
    /// framing) decodes to these, and the gateway re-encodes them into whichever
    /// dialect the client spoke. That keeps wire-format translation in one place.
    variant stream-event {
        /// Stream opened.
        started,
        /// Visible answer text.
        output-delta(indexed-text),
        /// Model reasoning; never merged into the visible answer.
        reasoning-delta(indexed-text),
        /// A tool-call fragment. The first event for an index carries the name and
        /// id; later ones carry input fragments to concatenate.
        tool-call-delta(tool-call-delta),
        /// The tool call at this index is complete; its input will not grow.
        tool-call-end(u32),
        usage(usage),
        /// Terminal event: "end_turn" | "max_tokens" | "stop_sequence" | "tool_use".
        completed(string),
        /// Terminal failure; the gateway maps this to an HTTP status.
        failed(stream-failure),
    }

    record indexed-text {
        text:  string,
        index: u32,
    }

    record tool-call-delta {
        tool-use-id: string,
        /// Set on the opening fragment; empty on continuation fragments.
        name:        string,
        input-delta: string,
        index:       u32,
    }

    record stream-failure {
        /// HTTP status to surface to the client.
        status:  u16,
        message: string,
    }

    // ── Model discovery ───────────────────────────────────────────────────────

    /// A model the provider currently offers.
    ///
    /// Providers add and retire models faster than a gateway ships, so a plugin
    /// may discover these at runtime instead of hardcoding a list.
    record model-info {
        /// Id to send upstream.
        id:               string,
        display-name:     option<string>,
        max-input-tokens:  option<u32>,
        max-output-tokens: option<u32>,
        /// e.g. ["text", "image"]
        input-types:      list<string>,
        supports-prompt-cache: bool,
    }

    // ── Routing ───────────────────────────────────────────────────────────────

    /// A candidate connection the gateway may dispatch to.
    record candidate {
        connection-id: string,
        provider:      string,
        model:         string,
        /// latest known health score [0.0, 1.0]
        health:        f32,
        /// tokens remaining in the quota window; none = unknown
        quota-remaining: option<u32>,
        /// estimated cost per 1k tokens in microdollars; none = unknown
        cost-per-ktoken: option<u32>,
        /// EWMA latency in milliseconds
        latency-p50-ms:  option<u32>,
    }

    /// Typed signals produced by one plugin stage and consumed by later stages.
    /// Keys are namespaced: "compress:tokens_after", "auth:tier", etc.
    type signal-map = list<tuple<string, string>>;

    record routing-context {
        request:    request,
        candidates: list<candidate>,
        signals:    signal-map,
        /// combo name that triggered this route, if any
        combo-id:   option<string>,
        /// mode pack in effect: "ship-fast" | "cost-saver" | "quality-first" | "offline-friendly"
        mode-pack:  option<string>,
    }

    // ── Auth ──────────────────────────────────────────────────────────────────

    record auth-context {
        tenant-id:    tenant-id,
        /// VKDG client key id (never the raw token)
        key-id:       string,
        role:         string,
        /// e.g. ["data:inference", "data:embeddings"]
        scopes:       list<string>,
        claims:       list<tuple<string, string>>,
    }

    // ── Cache ─────────────────────────────────────────────────────────────────

    record cache-entry {
        response:   response,
        /// unix seconds
        cached-at:  u64,
        ttl-secs:   option<u32>,
        /// "exact" | "semantic" | "provider"
        cache-type: string,
        hit-score:  option<f32>,
    }

    variant cache-result {
        hit(cache-entry),
        miss,
    }

    // ── Compression ───────────────────────────────────────────────────────────

    record compression-report {
        tokens-before:  u32,
        tokens-after:   u32,
        /// "caveman" | "rtk" | "truncate" | "summarize" | custom name
        algorithm:      string,
        /// percentage saved [0.0, 1.0]
        ratio:          f32,
        /// true if messages were structurally altered (for audit)
        lossy:          bool,
    }

    record compressed-request {
        messages:   list<message>,
        system:     option<string>,
        report:     compression-report,
    }

    // ── Errors ────────────────────────────────────────────────────────────────

    variant plugin-error {
        /// plugin rejected the operation; caller should fail-closed
        rejected(string),
        /// plugin failed; caller may fail-open or fail-closed per policy
        internal(string),
        /// not applicable for this request; skip this plugin
        not-applicable,
    }
}
